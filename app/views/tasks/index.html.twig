{% extends 'partials/base.html.twig' %}

{% block content %}
    <h1>
        Tasks overview
    </h1>
    <br>

    {% for task in tasks  %}
    <p>{{ task.title }}</p>
        <button class="btn btn-info">
         <a href="/tasks/edit_form/{{ task.id }}">Edit
         </a>
        </button>

        <button class="btn btn-info">
            <a href="/tasks/delete_form/{{ task.id }}">Delete
            </a>
        </button>
    {%  endfor  %}

    <button class="btn btn-info">
        <a href="/tasks/create_form"> create task</a>
    </button>
{% endblock %}